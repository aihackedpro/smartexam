{
  "name": "smartexam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "license:status": "node scripts/license-authority.mjs status",
    "license:issue": "node scripts/license-authority.mjs issue",
    "license:admin": "node scripts/license-admin-server.mjs",
    "native:sync": "npm run build && cap sync",
    "native:doctor": "cap doctor",
    "native:assets": "bash scripts/generate-native-assets.sh",
    "android:apk": "npm run native:sync && cd android && ./gradlew assembleDebug",
    "android:signing:setup": "bash scripts/setup-android-signing.sh",
    "android:release": "bash scripts/build-android-release.sh all",
    "android:bundle": "bash scripts/build-android-release.sh bundle",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "android:open": "cap open android",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "dexie": "^4.4.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
